# Deixe vazio para usar o banco embutido (PGlite) em .data/pglite
# DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
# --- WhatsApp (API oficial da Meta) — passo a passo em docs/WHATSAPP.md ---
# WHATSAPP_CHAVE_CRIPTO=        # texto aleatório com 32+ caracteres (criptografa os tokens). NÃO troque depois.
# WHATSAPP_APP_SECRET=          # App da Meta → Configurações → Básico → Chave secreta (valida o webhook)
# WHATSAPP_WEBHOOK_VERIFY_TOKEN= # texto qualquer, igual ao informado na Meta ao cadastrar o webhook
# WHATSAPP_GRAPH_VERSION=v25.0  # opcional
# CRON_SECRET=
# PAGAMENTOS_SANDBOX=1
# LEMBRETE_HORAS_ANTES=3
# ROTINAS_INTERNAS=1
# APP_URL=https://agenda.suabarbearia.com.br
# MODO_DEMO=1  # mostra o acesso de exemplo e o código de verificação na tela (só para demonstração)
# PGLITE_DIR=/tmp/pglite  # padrão automático na Vercel
